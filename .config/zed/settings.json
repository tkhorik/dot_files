{
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "kimi": {
      "type": "registry"
    },
    "gemini": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "favorite_config_option_values": {
        "mode": [
          "https://agentclientprotocol.com/protocol/session-modes#plan"
        ]
      },
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "agent": {
    "dock": "left",
    "default_model": {
      "provider": "zed.dev",
      "model": "gpt-5.3-codex",
    },
  },

  "language_models": {
    "zed.dev": {
      "command": "codex",
      "args": ["--acp"],
    },
  },

  "ssh_connections": [
    {
      "host": "192.168.1.101",
      "username": "katy",
      "args": [],
      "projects": [
        {
          "paths": ["/Users/katy/Projects/petclinic"],
        },
      ],
      "nickname": "katy",
    },
    {
      "host": "github.com",
      "args": [],
      "projects": [],
    },
  ],

  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },

  "session": {
    "trust_all_worktrees": true,
  },

  "vim_mode": true,
  "icon_theme": "Zed (Default)",
  "base_keymap": "JetBrains",

  "ui_font_size": 16,
  "buffer_font_size": 15,
  "buffer_font_family": "Lilex",

  "buffer_font_features": {
    "calt": true,
  },

    "theme": {
      "mode": "system",
      "light": "Gruvbox Light Soft",
      "dark": "Ayu Mirage"
    }
  }
  //disabler!
  // "disable_ai": true,
  // "show_completions_on_input": false,
  "edit_predictions": {
    "mode": "subtle",
  },
}
