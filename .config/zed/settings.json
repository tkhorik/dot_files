{
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle"
  },
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "agent_servers": {
    "kiro": {
      "default_mode": "kiro_guide",
      "type": "custom",
      "command": "/Users/marv/.local/bin/kiro-cli",
      "args": ["acp"],
      "env": {}
    },
    "antigravity-acp": {
      "default_config_options": {
        "model": "gemini-3.8-flash-high",
        "mode": "default"
      },
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-6-astra"
      },
      "type": "registry"
    },
    "kimi": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "favorite_config_option_values": {
        "mode": [
          "https://agentclientprotocol.com/protocol/session-modes#plan"
        ]
      },
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "model": "sonnet"
      },
      "type": "registry"
    }
  },
  "agent": {
    "dock": "left",
    "default_model": {
      "provider": "zed.dev",
      "model": "gpt-5.3-codex"
    }
  },
  "language_models": {
    "zed.dev": {
      "command": "codex",
      "args": ["--acp"]
    }
  },
  "ssh_connections": [
    {
      "host": "192.168.1.101",
      "username": "katy",
      "args": [],
      "projects": [
        {
          "paths": ["/Users/katy/Projects/petclinic"]
        }
      ],
      "nickname": "katy"
    },
    {
      "host": "github.com",
      "args": [],
      "projects": []
    }
  ],
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "icon_theme": "Zed (Default)",
  "base_keymap": "JetBrains",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "buffer_font_family": "Lilex",
