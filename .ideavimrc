" ==============================================================================
" INITIALIZATION & BASIC SETTINGS
" ==============================================================================

let mapleader = ' '

" Basic Vim settings
set ignorecase
set smartcase
set incsearch
set scrolloff=5
set showmode
set number
set relativenumber

" System clipboard
set clipboard+=unnamedplus
set clipboard+=ideaput

" IdeaVim settings
set ideastatusicon=gray
set ideajoin

" IdeaVim plugins
set multiple-cursors
set commentary
set vim-paragraph-motion
set textobj-indent
set highlightedyank
set NERDTree
set easymotion
set which-key
set surround

" Which-Key
set notimeout
let g:WhichKey_ShowVimActions = "true"
let g:WhichKey_PrefixStyle = "bold"

" Highlighted Yank
let g:highlightedyank_highlight_duration = "200"
let g:highlightedyank_highlight_color = "rgba(160,160,160,155)"

" Text objects / EasyMotion
let g:argtextobj_pairs = "[:],(:),<:>"
let g:EasyMotion_smartcase = 1

" ==============================================================================
" CORE MAPPINGS
" ==============================================================================

" Navigate between editor splits
nmap <C-h> <Action>(PrevSplitter)
nmap <C-l> <Action>(NextSplitter)
nmap <C-j> <Action>(SplitterDown)
nmap <C-k> <Action>(SplitterUp)

" Block comment
nmap gC <Action>(CommentByBlockComment)
vmap gC <Action>(CommentByBlockComment)

" Delete line without overwriting unnamed register
nnoremap dd "0dd

" ==============================================================================
" NAVIGATION / SEARCH
" ==============================================================================

nmap <leader>ff <Action>(GotoFile)
nmap <leader>fc <Action>(GotoClass)
nmap <leader>fs <Action>(GotoSymbol)
nmap <leader>fr <Action>(RecentFiles)
nmap <leader>fl <Action>(RecentLocations)
nmap <leader>ga <Action>(GotoAction)
nmap <leader>ag <Action>(FindInPath)

" ==============================================================================
" CODE NAVIGATION
" ==============================================================================

nmap <leader>gd <Action>(GotoDeclaration)
nmap <leader>gy <Action>(GotoTypeDeclaration)
nmap <leader>gi <Action>(GotoImplementation)
nmap <leader>gu <Action>(ShowUsages)
nmap <leader>gt <Action>(GotoTest)

nmap ]e <Action>(GotoNextError)
nmap [e <Action>(GotoPreviousError)

nmap ]] <Action>(MethodDown)
nmap [[ <Action>(MethodUp)

" ==============================================================================
" REFACTORING
" ==============================================================================

nmap <leader>rn <Action>(RenameElement)
nmap <leader>rm <Action>(ExtractMethod)
nmap <leader>rv <Action>(IntroduceVariable)
nmap <leader>rf <Action>(IntroduceField)
nmap <leader>rs <Action>(ChangeSignature)
nmap <leader>rr <Action>(Refactorings.QuickListPopupAction)

" ==============================================================================
" FORMATTING / INTENTIONS / GENERATION
" ==============================================================================

nmap <leader>f= <Action>(ReformatCode)
nmap <leader>. <Action>(ShowIntentionActions)
nmap <leader>pg <Action>(Generate)

vmap <leader>l <Action>(ReformatCode)

" ==============================================================================
" WINDOWS / UI
" ==============================================================================

nmap <leader>z <Action>(ToggleDistractionFreeMode)
nmap <leader>x <Action>(ToggleZenMode)
nmap <leader>t <Action>(ActivateTerminalToolWindow)

nmap <leader>wu <Action>(Unsplit)

nmap <leader>ps <Action>(FileStructurePopup)
nmap <leader>pv <Action>(SelectInProjectView)
nmap <leader>q <Action>(NERDTreeFind)

" ==============================================================================
" MISC
" ==============================================================================

nmap K <Action>(QuickJavaDoc)
nmap gI <Action>(QuickImplementations)

nmap <leader>9 <Action>(com.testoutputselector.FocusTestRunnerAction)

" Append semicolon and stay in Normal mode
nnoremap <leader>; A;<Esc>

" ==============================================================================
" EASYMOTION
" ==============================================================================

nmap <leader>j <Plug>(easymotion-j)
nmap <leader>k <Plug>(easymotion-k)
nmap <leader>F <Plug>(easymotion-bd-f)

" ==============================================================================
" EDITING HELPERS
" ==============================================================================

" Insert empty line below/above while staying in Normal mode
nnoremap zj o<Esc>k
nnoremap zk O<Esc>j
